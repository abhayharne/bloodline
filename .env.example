# Copy to .env (never commit .env)
PORT=8080
DB_PATH=./bloodline.db
JWT_SECRET=change-me
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Singapore data center (confirmed in docs.nexconn.ai/guides/data-center)
NEXCONN_API_BASE=https://api.sg-light-api.com
NEXCONN_API_BASE_BACKUP=https://api-b.sg-light-api.com
# Donor match radius in km
MATCH_RADIUS_KM=10
# Demo-only fixed OTP accepted by POST /auth/verify (never a real SMS gateway)
DEMO_OTP=123456
# Comma-separated client feature flags; empty by default (e.g. notifications,eligibility)
FEATURES=
