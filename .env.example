# Copy to .env (never commit .env)
PORT=8080
DB_PATH=./bloodline.db
JWT_SECRET=change-me
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Singapore data center (confirmed in docs.nexconn.ai/guides/data-center)
NEXCONN_API_BASE=https://api.sg-light-api.com
NEXCONN_API_BASE_BACKUP=https://api-b.sg-light-api.com
# Donor match radius in km
MATCH_RADIUS_KM=10
