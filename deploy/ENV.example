# Public demo configuration; set secrets privately in the hosting environment.
PORT=8080
DB_PATH=/data/bloodline.db
JWT_SECRET=
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE=
NEXCONN_API_BASE_BACKUP=
DEMO_OTP=123456
MATCH_RADIUS_KM=10
FEATURES=
SEED_ON_EMPTY=1
# Keep all three disabled on the public demo server.
DEV=0
NEXCONN_FAKE=0
NEXCONN_MOCK=0
# Only needed for a private DEV=1 server; X-Dev-Key must match this value.
DEV_KEY=
